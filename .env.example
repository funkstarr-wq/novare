# Copy to .env for local development. Never commit real values (.env is git-ignored).
# On Railway these are service variables; see docs/railway.md and .railway/railway.ts.

# Postgres. Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/novare
# Scratch database for `pnpm test` integration tests, so they never touch dev data. Local only.
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/novare_test
# Set to false to stop dev-mode schema push and rely on committed migrations (CI and Railway do).
PAYLOAD_DB_PUSH=

# 32+ random bytes, different per environment: openssl rand -hex 32
PAYLOAD_SECRET=
# Public origin, no trailing slash. Railway: https://${{RAILWAY_PUBLIC_DOMAIN}}
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Signs draft-mode preview links (M3)
PREVIEW_SECRET=
# Authorises on-demand revalidation (M2)
REVALIDATE_SECRET=
# Protects scheduled job endpoints (M7)
CRON_SECRET=

# Railway Bucket "media", S3-compatible. Railway: ${{media.BUCKET}}, ${{media.ENDPOINT}}, etc.
# Leave S3_BUCKET empty to store uploads on local disk (local dev and CI).
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
# Railway Buckets use virtual-hosted URLs; set true only for a path-style S3 provider.
S3_FORCE_PATH_STYLE=

# AI editor (M5). API key on production and staging only. The assistant refuses to run until a
# monthly budget is set here or in AI settings, and AI settings → Enabled is ticked.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# The cheap second opinion in the financial-claims check.
ANTHROPIC_CLASSIFIER_MODEL=claude-haiku-5-5
AI_MONTHLY_BUDGET_USD=
# 1 = use the scripted test model instead of the API (local and CI e2e only; ignored on Railway).
AI_MOCK=

# Transactional email (M7). Without a key, emails are written to the server log.
RESEND_API_KEY=
# "Novare <web@your-verified-domain>"
EMAIL_FROM=

# Cloudflare Turnstile on the enquiry forms (M7); both empty switches it off.
# The site key is read at build time.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Months to keep form submissions before the nightly job deletes them (default 12).
FORM_RETENTION_MONTHS=
# off = do not start Payload's job cron in this server.
PAYLOAD_JOBS=

# Optional: form submissions are also POSTed here (M7), signed with the secret
# (X-Novare-Signature: HMAC-SHA256 of the body).
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# `pnpm seed` creates this admin user if it does not exist (local, CI and PR environments only)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
